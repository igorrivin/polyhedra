{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/igorrivin/ideal_poly_volume_toolkit/schemas/optimization-result-v1.schema.json",
  "title": "Ideal polyhedron optimization result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "metadata",
    "best",
    "statistics",
    "all_trials"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source": {"type": "string", "minLength": 1},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "n_vertices",
        "objective",
        "implicit_infinity_index",
        "settings"
      ],
      "properties": {
        "timestamp": {"type": "string", "minLength": 1},
        "n_vertices": {"type": "integer", "minimum": 4},
        "objective": {"const": "vectorized_scipy_bloch_wigner"},
        "implicit_infinity_index": {"type": "integer", "minimum": 3},
        "settings": {"type": "object"},
        "n_trials": {"type": "integer", "minimum": 1},
        "maxiter": {"type": "integer", "minimum": 1},
        "popsize": {"type": "integer", "minimum": 1},
        "workers": {
          "type": "integer",
          "anyOf": [
            {"const": -1},
            {"minimum": 1}
          ]
        },
        "seed_base": {"type": "integer"}
      }
    },
    "best": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "volume",
        "params",
        "vertices_real",
        "vertices_imag",
        "structure",
        "triangulation",
        "finite_delaunay_triangulation",
        "boundary_triangulation"
      ],
      "properties": {
        "volume": {"type": "number", "exclusiveMinimum": 0},
        "params": {"$ref": "#/$defs/number_array"},
        "vertices_real": {"$ref": "#/$defs/number_array"},
        "vertices_imag": {"$ref": "#/$defs/number_array"},
        "structure": {"$ref": "#/$defs/structure"},
        "triangulation": {"$ref": "#/$defs/triangulation"},
        "finite_delaunay_triangulation": {
          "$ref": "#/$defs/triangulation"
        },
        "boundary_triangulation": {"$ref": "#/$defs/triangulation"}
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n_vertices",
        "n_faces",
        "n_finite_faces",
        "best_volume",
        "mean_volume",
        "std_volume",
        "all_volumes",
        "n_valid_trials",
        "n_invalid_trials"
      ],
      "properties": {
        "n_vertices": {"type": "integer", "minimum": 4},
        "n_faces": {"type": "integer", "minimum": 4},
        "n_finite_faces": {"type": "integer", "minimum": 1},
        "best_volume": {"type": "number", "exclusiveMinimum": 0},
        "mean_volume": {"type": "number", "exclusiveMinimum": 0},
        "std_volume": {"type": "number", "minimum": 0},
        "all_volumes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "n_valid_trials": {"type": "integer", "minimum": 1},
        "n_invalid_trials": {"type": "integer", "minimum": 0}
      }
    },
    "all_trials": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/trial"}
    }
  },
  "$defs": {
    "number_array": {
      "type": "array",
      "items": {"type": "number"}
    },
    "triangle": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "integer", "minimum": 0}
    },
    "triangulation": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/triangle"}
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n_vertices",
        "n_finite_vertices",
        "implicit_infinity_index",
        "n_faces",
        "n_finite_faces",
        "n_infinity_faces",
        "n_edges",
        "euler_characteristic",
        "vertex_degrees"
      ],
      "properties": {
        "n_vertices": {"type": "integer", "minimum": 4},
        "n_finite_vertices": {"type": "integer", "minimum": 3},
        "implicit_infinity_index": {"type": "integer", "minimum": 3},
        "n_faces": {"type": "integer", "minimum": 4},
        "n_finite_faces": {"type": "integer", "minimum": 1},
        "n_infinity_faces": {"type": "integer", "minimum": 3},
        "n_edges": {"type": "integer", "minimum": 6},
        "euler_characteristic": {"const": 2},
        "vertex_degrees": {
          "type": "array",
          "minItems": 4,
          "items": {"type": "integer", "minimum": 3}
        }
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"valid": {"const": true}}
          },
          "then": {
            "properties": {
              "volume": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        },
        {
          "if": {
            "properties": {"valid": {"const": false}}
          },
          "then": {
            "properties": {"volume": {"type": "null"}}
          }
        }
      ],
      "required": [
        "trial",
        "volume",
        "valid",
        "params",
        "success",
        "message",
        "iterations",
        "function_evals"
      ],
      "properties": {
        "trial": {"type": "integer", "minimum": 1},
        "volume": {
          "anyOf": [
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "null"}
          ]
        },
        "valid": {"type": "boolean"},
        "params": {"$ref": "#/$defs/number_array"},
        "success": {"type": "boolean"},
        "message": {"type": "string"},
        "iterations": {"type": "integer", "minimum": 0},
        "function_evals": {"type": "integer", "minimum": 0}
      }
    }
  }
}
